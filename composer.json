{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sifrious/titan",
    "description": "Framework-neutral contracts for compiling planning records into executable work kits.",
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": "^8.3",
        "sifrious/elwin": "dev-main",
        "sifrious/reference-contract": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\Titan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\Titan\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "phpunit"
    },
    "repositories": [
        {"type": "vcs", "url": "https://github.com/sifrious/dep-elwin.git"},
        {"type": "vcs", "url": "https://github.com/sifrious/dep-reference-contract.git"},
        {"type": "vcs", "url": "https://github.com/sifrious/quain.git"}
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
