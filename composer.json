{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sifrious/titan",
    "description": "Framework-neutral contracts for compiling planning records into executable work kits.",
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\Titan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\Titan\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "check": [
            "@test",
            "@analyse"
        ],
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
